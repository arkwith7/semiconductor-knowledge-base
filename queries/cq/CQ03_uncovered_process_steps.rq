# desc: 특허가 하나도 매핑되지 않은 공정 단계(커버리지 공백)를 찾을 수 있는가? — H1 의 핵심 질의
# suite: tf
# monotone: down
# expect-min: 0
PREFIX ont:  <https://w3id.org/sdkb/ont/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?level ?step ?stepLabel
WHERE {
  VALUES (?stepType ?level) { (ont:Process "process") (ont:SubProcess "subprocess") }
  ?step a ?stepType ; skos:prefLabel ?stepLabel .
  FILTER NOT EXISTS { ?p a ont:Patent ; ont:realizesProcess ?step . }
}
ORDER BY ?level ?stepLabel
