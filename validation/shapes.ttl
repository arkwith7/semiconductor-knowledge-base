@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix sdkb:    <https://w3id.org/sdkb/> .
@prefix ont:     <https://w3id.org/sdkb/ont/> .
@prefix gov:     <https://w3id.org/sdkb/gov/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# ═══════════════════════════════════════════════════════════════════
# SDKB v1.0 SHACL Shapes — Release Gate Validation Rules
# ═══════════════════════════════════════════════════════════════════

# ─── Every node must have a prefLabel and license ─────────────────
ont:Shape_CoreNode
    a sh:NodeShape ;
    sh:targetClass ont:Process, ont:SubProcess, ont:EquipmentClass,
        ont:Equipment, ont:Vendor, ont:Organization, ont:Parameter,
        ont:Metrology, ont:Material, ont:TechnologyNode,
        ont:FailureMode, ont:RootCause, ont:Mitigation, ont:Skill ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Every node must have at least one skos:prefLabel." ;
    ] ;
    sh:property [
        sh:path dcterms:license ;
        sh:minCount 1 ;
        sh:message "Every node must declare dcterms:license (SPDX identifier or URI)." ;
    ] ;
    sh:property [
        sh:path ont:interpretationType ;
        sh:minCount 1 ;
        sh:in ( "verbatim" "mapped" "author-defined" ) ;
        sh:message "interpretationType must be one of: verbatim, mapped, author-defined." ;
    ] .

# ─── Confidence score range (0.0–1.0) ────────────────────────────
ont:Shape_Confidence
    a sh:PropertyShape ;
    sh:path ont:confidence ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 1.0 ;
    sh:message "confidence must be a decimal in [0.0, 1.0]." .

# ─── FailureMode must link to at least one RootCause ─────────────
ont:Shape_FailureMode
    a sh:NodeShape ;
    sh:targetClass ont:FailureMode ;
    sh:property [
        sh:path ont:isDueTo ;
        sh:minCount 1 ;
        sh:class ont:RootCause ;
        sh:message "Every FailureMode must have at least one isDueTo → RootCause." ;
    ] ;
    sh:property [
        sh:path ont:occursAtProcessStep ;
        sh:minCount 1 ;
        sh:class ont:SubProcess ;
        sh:message "Every FailureMode must specify occursAtProcessStep → SubProcess." ;
    ] .

# ─── Equipment must be instance of an EquipmentClass ─────────────
ont:Shape_Equipment
    a sh:NodeShape ;
    sh:targetClass ont:Equipment ;
    sh:property [
        sh:path ont:isInstanceOf ;
        sh:minCount 1 ;
        sh:class ont:EquipmentClass ;
        sh:message "Every Equipment must have isInstanceOf → EquipmentClass." ;
    ] ;
    sh:property [
        sh:path ont:providedBy ;
        sh:minCount 1 ;
        sh:class ont:Vendor ;
        sh:message "Every Equipment must have providedBy → Vendor." ;
    ] .

# ─── Governance: EAR rule nodes must have effective date ──────────
gov:Shape_EARRule
    a sh:NodeShape ;
    sh:targetClass gov:EARRule ;
    sh:property [
        sh:path ont:effectiveDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "EARRule must specify effectiveDate." ;
    ] ;
    sh:property [
        sh:path dcterms:bibliographicCitation ;
        sh:minCount 1 ;
        sh:message "EARRule must cite the regulation section." ;
    ] .

# ─── Governance: SCIP rule threshold ─────────────────────────────
gov:Shape_SCIPRule
    a sh:NodeShape ;
    sh:targetClass gov:SCIPRule ;
    sh:property [
        sh:path ont:svhcConcentration ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "SCIPRule must specify svhcConcentration threshold." ;
    ] .

# ─── TPP export control rule (BIS §744.23) ───────────────────────
# If tppValue >= 4800, securityLevel must be RESTRICTED
ont:Shape_TPPExportControl
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:tppValue ;
    sh:property [
        sh:path ont:tppValue ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:sparql [
        sh:message "Equipment with TPP >= 4800 must have securityLevel = RESTRICTED." ;
        sh:select """
            PREFIX ont: <https://w3id.org/sdkb/ont/>
            SELECT $this
            WHERE {
                $this ont:tppValue ?tpp .
                FILTER (?tpp >= 4800)
                OPTIONAL { $this ont:securityLevel ?sec . }
                FILTER (!bound(?sec) || ?sec != "RESTRICTED")
            }
        """ ;
    ] .

# ─── Provenance: every node should trace back to a source ────────
ont:Shape_Provenance
    a sh:NodeShape ;
    sh:targetClass ont:Process, ont:SubProcess, ont:EquipmentClass,
        ont:Equipment, ont:Material, ont:FailureMode,
        ont:RootCause, ont:Mitigation, ont:Skill ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every curated node must declare dcterms:source." ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# Enrichment layer shapes (Phase 1 v1.1, SemicONTO-derived axioms)
# See docs/architecture_amendment_sdkb_centric.md
# ═══════════════════════════════════════════════════════════════════

# ─── ExtrinsicSemiconductor must declare its dopant species ──────
# Mirrors SemicONTO's OWL axiom: ExtrinsicSemiconductor ⊑ ((hasAcceptor
# some Material) ⊓ (hasAcceptor only Material)) ⊓ ((hasDonor some
# Material) ⊓ (hasDonor only Material)) — relaxed to "either acceptor
# or donor" because real-world doped materials need at least one,
# not necessarily both.
ont:Shape_ExtrinsicSemiconductor
    a sh:NodeShape ;
    sh:targetClass ont:ExtrinsicSemiconductor ;
    sh:or (
        [ sh:path ont:hasAcceptor ; sh:minCount 1 ; sh:class ont:Material ]
        [ sh:path ont:hasDonor    ; sh:minCount 1 ; sh:class ont:Material ]
    ) ;
    sh:message "ExtrinsicSemiconductor must have at least one hasAcceptor or hasDonor → Material." .

# ─── hasAcceptor / hasDonor domain restriction ───────────────────
# Subject of these predicates must be an ExtrinsicSemiconductor.
ont:Shape_DopantPredicate_hasAcceptor
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasAcceptor ;
    sh:class ont:ExtrinsicSemiconductor ;
    sh:message "Subject of hasAcceptor must be rdf:type ExtrinsicSemiconductor." .

ont:Shape_DopantPredicate_hasDonor
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasDonor ;
    sh:class ont:ExtrinsicSemiconductor ;
    sh:message "Subject of hasDonor must be rdf:type ExtrinsicSemiconductor." .

# ─── hasNextStep / hasSubStep range = SubProcess ─────────────────
ont:Shape_HasNextStep
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasNextStep ;
    sh:property [
        sh:path ont:hasNextStep ;
        sh:class ont:SubProcess ;
        sh:nodeKind sh:IRI ;
        sh:message "hasNextStep range must be a SubProcess instance." ;
    ] .

ont:Shape_HasSubStep
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasSubStep ;
    sh:property [
        sh:path ont:hasSubStep ;
        sh:class ont:SubProcess ;
        sh:nodeKind sh:IRI ;
        sh:message "hasSubStep range must be a SubProcess instance." ;
    ] .

# ─── hasEquipment range = Equipment ──────────────────────────────
ont:Shape_HasEquipment
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasEquipment ;
    sh:property [
        sh:path ont:hasEquipment ;
        sh:class ont:Equipment ;
        sh:nodeKind sh:IRI ;
        sh:message "hasEquipment range must be an Equipment instance." ;
    ] .

# ─── Dopant instance must be Acceptor or Donor ───────────────────
# Implements OWL axiom Dopant ≡ Acceptor ∪ Donor at the SHACL level.
ont:Shape_DopantInstance
    a sh:NodeShape ;
    sh:targetClass ont:Dopant ;
    sh:or (
        [ sh:class ont:Acceptor ]
        [ sh:class ont:Donor ]
    ) ;
    sh:message "Every Dopant instance must also be Acceptor or Donor (Dopant ≡ Acceptor ∪ Donor)." .

# ─── Standard Reference (Link-Only) must have URL ────────────────
gov:Shape_StandardReference
    a sh:NodeShape ;
    sh:targetClass gov:StandardReference ;
    sh:property [
        sh:path <http://www.w3.org/2000/01/rdf-schema#seeAlso> ;
        sh:minCount 1 ;
        sh:message "StandardReference must have rdfs:seeAlso (URL to standard)." ;
    ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "StandardReference must have a label." ;
    ] .
