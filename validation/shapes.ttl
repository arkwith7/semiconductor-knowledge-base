@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix sdkb:    <https://w3id.org/sdkb/> .
@prefix ont:     <https://w3id.org/sdkb/ont/> .
@prefix gov:     <https://w3id.org/sdkb/gov/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

# ═══════════════════════════════════════════════════════════════════
# SDKB v1.0 SHACL Shapes — Release Gate Validation Rules
# ═══════════════════════════════════════════════════════════════════

# ─── Every node must have a prefLabel and license ─────────────────
ont:Shape_CoreNode
    a sh:NodeShape ;
    sh:targetClass ont:Process, ont:SubProcess, ont:EquipmentClass,
        ont:Equipment, ont:Vendor, ont:Organization, ont:Parameter,
        ont:Metrology, ont:Material, ont:TechnologyNode,
        ont:FailureMode, ont:RootCause, ont:Mitigation, ont:Skill,
        ont:StructuralElement ;   # PLAN-005 5-B — 구조요소 15 노드도 같은 게이트를 받는다
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Every node must have at least one skos:prefLabel." ;
    ] ;
    sh:property [
        sh:path dcterms:license ;
        sh:minCount 1 ;
        sh:message "Every node must declare dcterms:license (SPDX identifier or URI)." ;
    ] ;
    sh:property [
        sh:path ont:interpretationType ;
        sh:minCount 1 ;
        sh:in ( "verbatim" "mapped" "author-defined" ) ;
        sh:message "interpretationType must be one of: verbatim, mapped, author-defined." ;
    ] .

# ─── Expert/Problem 도 이름이 있어야 한다 ────────────────────────
# Shape_CoreNode 의 대상에서 Expert·Problem 만 빠져 있었고, 그래서 이 둘이 rdfs:label 만
# 달고 다니는 것을 게이트가 잡지 못했다. 결과: "이 공정에 필요한 스킬을 가진 전문가는
# 누구인가" 라는 질의가 답은 하되 **IRI 만** 돌려줬다 (읽을 수 있는 답이 아니었다).
#
# license·interpretationType 은 요구하지 않는다 — 이 두 클래스는 큐레이션 원천이 다르고
# 프로비넌스 부여는 별개 과제다. 없는 것을 있는 척하지 않는다.
ont:Shape_PersonProblemLabel
    a sh:NodeShape ;
    sh:targetClass ont:Expert, ont:Problem ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Expert/Problem must have a language-tagged skos:prefLabel (not rdfs:label)." ;
    ] .

# ─── EquipmentModel must have a label ────────────────────────────
# 전문가 프로필의 equipment_models 를 실체화한 노드. license·provenance 는 요구하지
# 않는다 — Expert/Problem 과 같은 큐레이션 원천이라 (없는 것을 있는 척하지 않는다).
ont:Shape_EquipmentModel
    a sh:NodeShape ;
    sh:targetClass ont:EquipmentModel ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Every EquipmentModel must have a language-tagged skos:prefLabel." ;
    ] .

# ─── ExpertCase reification: label + provenance + typed links ─────
# case_experience 를 그룹핑한 노드. 이름·출처는 필수(정직한 프로비넌스), 개별 링크는
# 미해결일 수 있어 필수로 하지 않되 존재하면 range 를 검증한다 (어휘가 SHACL 에 보이게).
ont:Shape_ExpertCase
    a sh:NodeShape ;
    sh:targetClass ont:ExpertCase ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Every ExpertCase must have a language-tagged skos:prefLabel." ;
    ] ;
    sh:property [
        sh:path ont:caseSource ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Every ExpertCase must record caseSource (provenance)." ;
    ] ;
    sh:property [
        sh:path ont:caseProcess ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class ont:Process ] [ sh:class ont:SubProcess ] ) ;
        sh:message "caseProcess range must be a Process or SubProcess instance." ;
    ] ;
    sh:property [
        sh:path ont:caseFailureMode ;
        sh:class ont:FailureMode ; sh:nodeKind sh:IRI ;
        sh:message "caseFailureMode range must be a FailureMode instance." ;
    ] ;
    sh:property [
        sh:path ont:caseRootCause ;
        sh:class ont:RootCause ; sh:nodeKind sh:IRI ;
        sh:message "caseRootCause range must be a RootCause instance." ;
    ] ;
    sh:property [
        sh:path ont:caseMitigation ;
        sh:class ont:Mitigation ; sh:nodeKind sh:IRI ;
        sh:message "caseMitigation range must be a Mitigation instance." ;
    ] ;
    sh:property [
        sh:path ont:caseParameter ;
        sh:class ont:Parameter ; sh:nodeKind sh:IRI ;
        sh:message "caseParameter range must be a Parameter instance." ;
    ] .

# ─── Expert career datatype fields (protocol §1.5) ───────────────
# 신규 적재 경력 필드의 자료형을 검증한다. 존재는 강제하지 않는다(retirementYear 는
# 은퇴자만, 등). 목적은 어휘가 SHACL 에 보이고(§5.2) 자료형이 옳게 실렸음을 고정하는 것.
ont:Shape_ExpertCareer
    a sh:NodeShape ;
    sh:targetClass ont:Expert ;
    sh:property [ sh:path ont:age ;              sh:datatype xsd:integer ] ;
    sh:property [ sh:path ont:yearsExperience ;  sh:datatype xsd:integer ] ;
    sh:property [ sh:path ont:patentCount ;      sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ont:publicationCount ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ont:toeicScore ;       sh:datatype xsd:integer ] ;
    sh:property [ sh:path ont:retirementYear ;   sh:datatype xsd:gYear ] ;
    sh:property [ sh:path ont:lastActivity ;     sh:datatype xsd:date ] ;
    sh:property [ sh:path ont:hasNCT ;           sh:datatype xsd:boolean ] ;
    sh:property [ sh:path ont:education ;         sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:currentStatus ;     sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:formerEmployer ;    sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:securityClearance ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:consultingAvailability ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:specialization ;    sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:profileSummary ;    sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:hourlyRateRange ;   sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:nationality ;       sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:hasCertification ;  sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:language ;          sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:majorProject ;      sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:preferredProjectType ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ont:workHistoryCountry ;   sh:datatype xsd:string ] .

# ─── Confidence score range (0.0–1.0) ────────────────────────────
ont:Shape_Confidence
    a sh:PropertyShape ;
    sh:path ont:confidence ;
    sh:datatype xsd:decimal ;
    sh:minInclusive 0.0 ;
    sh:maxInclusive 1.0 ;
    sh:message "confidence must be a decimal in [0.0, 1.0]." .

# ─── FailureMode must link to at least one RootCause ─────────────
ont:Shape_FailureMode
    a sh:NodeShape ;
    sh:targetClass ont:FailureMode ;
    sh:property [
        sh:path ont:isDueTo ;
        sh:minCount 1 ;
        sh:class ont:RootCause ;
        sh:message "Every FailureMode must have at least one isDueTo → RootCause." ;
    ] ;
    sh:property [
        sh:path ont:occursAtProcessStep ;
        sh:minCount 1 ;
        sh:class ont:SubProcess ;
        sh:message "Every FailureMode must specify occursAtProcessStep → SubProcess." ;
    ] .

# ─── Equipment must be instance of an EquipmentClass ─────────────
ont:Shape_Equipment
    a sh:NodeShape ;
    sh:targetClass ont:Equipment ;
    sh:property [
        sh:path ont:isInstanceOf ;
        sh:minCount 1 ;
        sh:class ont:EquipmentClass ;
        sh:message "Every Equipment must have isInstanceOf → EquipmentClass." ;
    ] ;
    sh:property [
        sh:path ont:providedBy ;
        sh:minCount 1 ;
        sh:class ont:Vendor ;
        sh:message "Every Equipment must have providedBy → Vendor." ;
    ] .

# ─── Governance: EAR rule nodes must have effective date ──────────
gov:Shape_EARRule
    a sh:NodeShape ;
    sh:targetClass gov:EARRule ;
    sh:property [
        sh:path ont:effectiveDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "EARRule must specify effectiveDate." ;
    ] ;
    sh:property [
        sh:path dcterms:bibliographicCitation ;
        sh:minCount 1 ;
        sh:message "EARRule must cite the regulation section." ;
    ] .

# ─── Governance: SCIP rule threshold ─────────────────────────────
gov:Shape_SCIPRule
    a sh:NodeShape ;
    sh:targetClass gov:SCIPRule ;
    sh:property [
        sh:path ont:svhcConcentration ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "SCIPRule must specify svhcConcentration threshold." ;
    ] .

# ─── TPP export control rule (BIS §744.23) ───────────────────────
# If tppValue >= 4800, securityLevel must be RESTRICTED
ont:Shape_TPPExportControl
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:tppValue ;
    sh:property [
        sh:path ont:tppValue ;
        sh:datatype xsd:decimal ;
    ] ;
    sh:sparql [
        sh:message "Equipment with TPP >= 4800 must have securityLevel = RESTRICTED." ;
        sh:select """
            PREFIX ont: <https://w3id.org/sdkb/ont/>
            SELECT $this
            WHERE {
                $this ont:tppValue ?tpp .
                FILTER (?tpp >= 4800)
                OPTIONAL { $this ont:securityLevel ?sec . }
                FILTER (!bound(?sec) || ?sec != "RESTRICTED")
            }
        """ ;
    ] .

# ─── Provenance: every node should trace back to a source ────────
ont:Shape_Provenance
    a sh:NodeShape ;
    sh:targetClass ont:Process, ont:SubProcess, ont:EquipmentClass,
        ont:Equipment, ont:Material, ont:FailureMode,
        ont:RootCause, ont:Mitigation, ont:Skill,
        ont:StructuralElement ;   # PLAN-005 5-B
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every curated node must declare dcterms:source." ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# Enrichment layer shapes (Phase 1 v1.1, SemicONTO-derived axioms)
# See docs/architecture_amendment_sdkb_centric.md
# ═══════════════════════════════════════════════════════════════════

# ─── ExtrinsicSemiconductor must declare its dopant species ──────
# Mirrors SemicONTO's OWL axiom: ExtrinsicSemiconductor ⊑ ((hasAcceptor
# some Material) ⊓ (hasAcceptor only Material)) ⊓ ((hasDonor some
# Material) ⊓ (hasDonor only Material)) — relaxed to "either acceptor
# or donor" because real-world doped materials need at least one,
# not necessarily both.
ont:Shape_ExtrinsicSemiconductor
    a sh:NodeShape ;
    sh:targetClass ont:ExtrinsicSemiconductor ;
    sh:or (
        [ sh:path ont:hasAcceptor ; sh:minCount 1 ; sh:class ont:Material ]
        [ sh:path ont:hasDonor    ; sh:minCount 1 ; sh:class ont:Material ]
    ) ;
    sh:message "ExtrinsicSemiconductor must have at least one hasAcceptor or hasDonor → Material." .

# ─── hasAcceptor / hasDonor domain restriction ───────────────────
# Subject of these predicates must be an ExtrinsicSemiconductor.
ont:Shape_DopantPredicate_hasAcceptor
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasAcceptor ;
    sh:class ont:ExtrinsicSemiconductor ;
    sh:message "Subject of hasAcceptor must be rdf:type ExtrinsicSemiconductor." .

ont:Shape_DopantPredicate_hasDonor
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasDonor ;
    sh:class ont:ExtrinsicSemiconductor ;
    sh:message "Subject of hasDonor must be rdf:type ExtrinsicSemiconductor." .

# ─── hasNextStep / hasSubStep range = SubProcess ─────────────────
ont:Shape_HasNextStep
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasNextStep ;
    sh:property [
        sh:path ont:hasNextStep ;
        sh:class ont:SubProcess ;
        sh:nodeKind sh:IRI ;
        sh:message "hasNextStep range must be a SubProcess instance." ;
    ] .

ont:Shape_HasSubStep
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasSubStep ;
    sh:property [
        sh:path ont:hasSubStep ;
        sh:class ont:SubProcess ;
        sh:nodeKind sh:IRI ;
        sh:message "hasSubStep range must be a SubProcess instance." ;
    ] .

# ─── hasEquipment range = Equipment ──────────────────────────────
ont:Shape_HasEquipment
    a sh:NodeShape ;
    sh:targetSubjectsOf ont:hasEquipment ;
    sh:property [
        sh:path ont:hasEquipment ;
        sh:class ont:Equipment ;
        sh:nodeKind sh:IRI ;
        sh:message "hasEquipment range must be an Equipment instance." ;
    ] .

# ─── Dopant instance must be Acceptor or Donor ───────────────────
# Implements OWL axiom Dopant ≡ Acceptor ∪ Donor at the SHACL level.
ont:Shape_DopantInstance
    a sh:NodeShape ;
    sh:targetClass ont:Dopant ;
    sh:or (
        [ sh:class ont:Acceptor ]
        [ sh:class ont:Donor ]
    ) ;
    sh:message "Every Dopant instance must also be Acceptor or Donor (Dopant ≡ Acceptor ∪ Donor)." .

# ─── Standard Reference (Link-Only) must have URL ────────────────
gov:Shape_StandardReference
    a sh:NodeShape ;
    sh:targetClass gov:StandardReference ;
    sh:property [
        sh:path <http://www.w3.org/2000/01/rdf-schema#seeAlso> ;
        sh:minCount 1 ;
        sh:message "StandardReference must have rdfs:seeAlso (URL to standard)." ;
    ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "StandardReference must have a label." ;
    ] .

# ═══════════════════════════════════════════════════════════════════
# CR-007 — 개념 상하위 (skos:broader)
# ═══════════════════════════════════════════════════════════════════

# ─── broader 의 값은 IRI 여야 한다 ────────────────────────────────
# 리터럴 계층은 조용히 죽은 계층이다 — 질의로 따라갈 수 없다.
ont:Shape_ConceptBroader
    a sh:NodeShape ;
    sh:targetSubjectsOf skos:broader ;
    sh:property [
        sh:path skos:broader ;
        sh:nodeKind sh:IRI ;
        sh:message "skos:broader must point at an IRI, not a literal." ;
    ] .

# ─── 상위 개념은 하위를 ≥1 개 가져야 한다 (CR-007 성공기준 ⑩) ────
# 하위가 없는 상위 개념은 재지정이 붙을 자리를 만들지 못한 것이고,
# 그때 이 CR 은 목적을 달성하지 못한 것이다. 그래서 계약으로 고정한다.
ont:Shape_SuperordinateHasNarrower
    a sh:NodeShape ;
    sh:targetNode
        <https://w3id.org/sdkb/data/equipment_class/process_chamber>,
        <https://w3id.org/sdkb/data/material/process_gas>,
        <https://w3id.org/sdkb/data/process/plasma_processing>,
        <https://w3id.org/sdkb/data/material/photomask>,
        <https://w3id.org/sdkb/data/material/dielectric>,
        <https://w3id.org/sdkb/data/material/oxide>,
        <https://w3id.org/sdkb/data/material/cmp_slurry> ;
    sh:property [
        sh:path [ sh:inversePath skos:broader ] ;
        sh:minCount 1 ;
        sh:message "Superordinate concept introduced by CR-007 must have at least one narrower concept." ;
    ] .
