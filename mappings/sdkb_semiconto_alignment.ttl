sdkb:Equipment owl:equivalentClass semiconto:Equipment ;
    skos:exactMatch semiconto:Equipment .

sdkb:Material owl:equivalentClass semiconto:Material ;
    skos:exactMatch semiconto:Material .

sdkb:Metrology skos:broadMatch semiconto:ExperimentalMethod .

sdkb:Organization skos:broadMatch prov:Agent .

sdkb:Parameter skos:closeMatch semiconto:MaterialProperty .

sdkb:Process skos:broadMatch semiconto:Experiment .

sdkb:SubProcess skos:closeMatch semiconto:ExperimentalStep .

sdkb:Vendor skos:broadMatch prov:Agent .

semiconto:hasExperimentAim rdfs:comment "The aim/purpose of an experiment is its definitional statement; SDKB uses skos:definition for free-text definitions."@en .

semiconto:hasExperimentName rdfs:comment "SemicONTO's experiment-name string is the canonical label of the experiment instance; SDKB uses skos:prefLabel for canonical names."@en .

semiconto:hasExperimentalStepAim rdfs:comment "Same convention as hasExperimentAim, applied to a step's purpose."@en .

semiconto:hasExperimentalStepDescription rdfs:comment "Step description maps to the same skos:definition role used by SDKB for free-text descriptions."@en .

semiconto:hasExperimentalStepID rdfs:comment "Stable identifier role; SDKB uses dcterms:identifier (also encoded in the node URI fragment)."@en .

