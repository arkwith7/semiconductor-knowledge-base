@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdkb: <https://w3id.org/sdkb/ont/> .
@prefix semiconto: <http://w3id.org/SemicONTO/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

dcterms:identifier skos:closeMatch semiconto:hasExperimentalStepID .

skos:definition skos:closeMatch semiconto:hasExperimentAim,
        semiconto:hasExperimentalStepAim,
        semiconto:hasExperimentalStepDescription .

skos:prefLabel skos:closeMatch semiconto:hasExperimentName .

<https://w3id.org/sdkb/alignment/semiconto> a owl:Ontology ;
    rdfs:label "SDKB ↔ SemicONTO Alignment (SDKB-centric, SKOS mappings)"@en ;
    dcterms:source <http://w3id.org/SemicONTO/0.2/> ;
    rdfs:comment "SKOS mappings from SDKB v1.0 (trunk) to SemicONTO v0.2 (external curation source). SDKB does not owl:imports SemicONTO; SemicONTO terms are referenced by IRI only."@en ;
    owl:versionInfo "0.3-phase0" .

