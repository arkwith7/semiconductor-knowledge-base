{
  "@context": {
    "@version": 1.1,

    "sdkb":    "https://w3id.org/sdkb/",
    "ont":     "https://w3id.org/sdkb/ont/",
    "data":    "https://w3id.org/sdkb/data/",
    "gov":     "https://w3id.org/sdkb/gov/",

    "prov":    "http://www.w3.org/ns/prov#",
    "skos":    "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "rdfs":    "http://www.w3.org/2000/01/rdf-schema#",
    "owl":     "http://www.w3.org/2002/07/owl#",
    "xsd":     "http://www.w3.org/2001/XMLSchema#",

    "id":          "@id",
    "type":        "@type",

    "label":       { "@id": "skos:prefLabel", "@language": "en" },
    "altLabel":    { "@id": "skos:altLabel" },
    "definition":  { "@id": "skos:definition", "@language": "en" },
    "comment":     { "@id": "rdfs:comment", "@language": "en" },

    "license":     "dcterms:license",
    "source":      "dcterms:source",
    "citation":    "dcterms:bibliographicCitation",
    "seeAlso":     { "@id": "rdfs:seeAlso", "@type": "@id" },

    "wasDerivedFrom":   { "@id": "prov:wasDerivedFrom",    "@type": "@id" },
    "wasGeneratedBy":   { "@id": "prov:wasGeneratedBy",    "@type": "@id" },
    "wasAttributedTo":  { "@id": "prov:wasAttributedTo",   "@type": "@id" },

    "confidence":          { "@id": "ont:confidence",          "@type": "xsd:decimal" },
    "probability":         { "@id": "ont:probability",         "@type": "xsd:decimal" },
    "interpretationType":  "ont:interpretationType",
    "validationRequired":  { "@id": "ont:validationRequired",  "@type": "xsd:boolean" },
    "securityLevel":       "ont:securityLevel",
    "changeSet":           "ont:changeSet",
    "reviewStatus":        "ont:reviewStatus",
    "tppValue":            { "@id": "ont:tppValue",            "@type": "xsd:decimal" },
    "svhcConcentration":   { "@id": "ont:svhcConcentration",   "@type": "xsd:decimal" },
    "effectiveDate":       { "@id": "ont:effectiveDate",       "@type": "xsd:date" },

    "hasSubprocess":       { "@id": "ont:hasSubprocess",       "@type": "@id" },
    "usesMaterial":        { "@id": "ont:usesMaterial",        "@type": "@id" },
    "usesEquipmentClass":  { "@id": "ont:usesEquipmentClass",  "@type": "@id" },
    "isInstanceOf":        { "@id": "ont:isInstanceOf",        "@type": "@id" },
    "providedBy":          { "@id": "ont:providedBy",          "@type": "@id" },
    "isDueTo":             { "@id": "ont:isDueTo",             "@type": "@id" },
    "occursAtProcessStep": { "@id": "ont:occursAtProcessStep", "@type": "@id" },
    "mitigatedBy":         { "@id": "ont:mitigatedBy",         "@type": "@id" },
    "affectsMetric":       { "@id": "ont:affectsMetric",       "@type": "@id" },
    "requiresSkill":       { "@id": "ont:requiresSkill",       "@type": "@id" },
    "relevantForTechNode": { "@id": "ont:relevantForTechNode", "@type": "@id" },
    "incompatibleWith":    { "@id": "ont:incompatibleWith",    "@type": "@id" },
    "notAllowedWith":      { "@id": "ont:notAllowedWith",      "@type": "@id" },
    "hasECCN":             { "@id": "ont:hasECCN",             "@type": "@id" },
    "controlledBy":        { "@id": "ont:controlledBy",        "@type": "@id" },
    "hasSVHC":             { "@id": "ont:hasSVHC",             "@type": "@id" },
    "standardRef":         { "@id": "ont:standardRef",         "@type": "@id" },
    "hasEquipmentState":   { "@id": "ont:hasEquipmentState",   "@type": "@id" },

    "Process":        "ont:Process",
    "SubProcess":     "ont:SubProcess",
    "EquipmentClass": "ont:EquipmentClass",
    "Equipment":      "ont:Equipment",
    "Vendor":         "ont:Vendor",
    "Organization":   "ont:Organization",
    "Parameter":      "ont:Parameter",
    "Metrology":      "ont:Metrology",
    "Material":       "ont:Material",
    "TechnologyNode": "ont:TechnologyNode",
    "FailureMode":    "ont:FailureMode",
    "RootCause":      "ont:RootCause",
    "Mitigation":     "ont:Mitigation",
    "Skill":          "ont:Skill",

    "EARRule":          "gov:EARRule",
    "RegulatedItem":    "gov:RegulatedItem",
    "NISTFunction":     "gov:NISTFunction",
    "NISTOutcome":      "gov:NISTOutcome",
    "SCIPRule":         "gov:SCIPRule",
    "StandardReference":"gov:StandardReference",
    "EquipmentState":   "gov:EquipmentState"
  }
}
